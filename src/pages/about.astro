---
import ContactActions from "../components/ContactActions.astro";
import PageContainer from "../components/PageContainer.astro";
import BaseLayout from "../layouts/BaseLayout.astro";
import { about } from "../data/about";

const description =
  "Senior Product Designer with 9+ years across digital products, enterprise SaaS, fintech, e-commerce, and strategic innovation.";
---

<BaseLayout
  title="About Pedro Martins | Senior Product Designer"
  description={description}
  jsonLd={{
    "@context": "https://schema.org",
    "@type": "ProfilePage",
    name: "About Pedro Martins",
    description,
    mainEntity: {
      "@type": "Person",
      name: "Pedro Martins",
      jobTitle: "Senior Product Designer",
      url: "https://www.martinspedro.com/about",
      sameAs: ["https://www.linkedin.com/in/pdomartins/"],
      knowsAbout: ["Product strategy", "UX/UI design", "Service design", "AI-enabled products", "Design systems"],
    },
  }}
>
  <PageContainer>
    <article class="about-page">
      <header class="about-opening">
        <p class="eyebrow">{about.eyebrow}</p>
        <h1 class="about-headline">{about.headline}</h1>
        <div class="about-intro">
          {about.introduction.map((paragraph) => <p>{paragraph}</p>)}
          <p class="about-perspective">{about.perspective}</p>
        </div>
      </header>

      <section class="about-section" id="experience" aria-labelledby="experience-title">
        <h2 id="experience-title"><span class="section-icon" aria-hidden="true">✦</span>Experience</h2>
        <ol class="role-list">
          {
            about.experience.map((job) => (
              <li class="role">
                <div class="role-meta">
                  <p class="role-dates">{job.dates}</p>
                  <p class="role-company">{job.company}</p>
                </div>
                <div class="role-body">
                  <h3>{job.role}</h3>
                  <p>{job.summary}</p>
                  {job.points && (
                    <ul class="role-points">
                      {job.points.map((point) => (
                        <li>{point}</li>
                      ))}
                    </ul>
                  )}
                  {job.notes?.map((note) => (
                    <p class="role-note">
                      <span>{note.label}</span>
                      {note.text}
                    </p>
                  ))}
                </div>
              </li>
            ))
          }
        </ol>
      </section>

      <section class="about-section" id="education" aria-labelledby="education-title">
        <h2 id="education-title"><span class="section-icon" aria-hidden="true">◫</span>Education &amp; Learning</h2>
        <div class="study-grid">
          <div>
            <h3>Degrees</h3>
            <ul class="study-list">
              {
                about.degrees.map((item) => (
                  <li>
                    <p class="study-name">{item.name}</p>
                    <p class="study-meta">
                      {item.institution}
                      <span aria-hidden="true"> · </span>
                      <span class="sr-only">, </span>
                      {item.period}
                    </p>
                  </li>
                ))
              }
            </ul>
          </div>
          <div>
            <h3>Courses</h3>
            <ul class="study-list">
              {
                about.courses.map((item) => (
                  <li>
                    <p class="study-name">{item.name}</p>
                    <p class="study-meta">
                      {item.institution}
                      <span aria-hidden="true"> · </span>
                      <span class="sr-only">, </span>
                      {item.period}
                    </p>
                  </li>
                ))
              }
            </ul>
          </div>
        </div>
      </section>

      <section class="about-section" id="practice" aria-labelledby="practice-title">
        <h2 id="practice-title"><span class="section-icon" aria-hidden="true">✳</span>Areas of Practice</h2>
        <div class="practice-grid">
          {
            about.practice.map((group) => (
              <div>
                <h3>{group.title}</h3>
                <ul class="practice-list">
                  {group.items.map((item) => (
                    <li>{item}</li>
                  ))}
                </ul>
              </div>
            ))
          }
        </div>
      </section>

      <section class="about-section" id="recognition" aria-labelledby="recognition-title">
        <h2 id="recognition-title"><span class="section-icon" aria-hidden="true">◇</span>Recognition</h2>
        <ul class="award-list">
          {
            about.awards.map((award) => (
              <li>
                <p class="award-when">{award.when}</p>
                <h3>{award.name}</h3>
                <p class="award-detail">{award.detail}</p>
              </li>
            ))
          }
        </ul>
      </section>

      <section class="about-close" id="contact" aria-labelledby="about-contact-title">
        <h2 id="about-contact-title">Have a product, service, or idea worth moving forward?</h2>
        <p>{about.contact.text}</p>
        <ContactActions email={about.contact.email} linkedin={about.contact.linkedin} />
      </section>
    </article>
  </PageContainer>
</BaseLayout>

<style>
  .about-page {
    padding-bottom: var(--space-6);
  }

  .about-opening {
    position: relative;
    padding-block: var(--space-8) var(--space-7);
    border-bottom: 1px solid var(--line);
  }

  .about-headline {
    max-width: 16em;
    margin-top: var(--space-4);
    font-family: var(--font-serif);
    font-optical-sizing: auto;
    font-size: clamp(2.15rem, 1rem + 3.1vw, 3.65rem);
    font-weight: 450;
    letter-spacing: -0.035em;
    line-height: 1.05;
  }

  .about-intro {
    max-width: 40rem;
    margin-top: var(--space-6);
    display: grid;
    gap: 1rem;
  }

  .about-intro p {
    font-family: var(--font-serif);
    font-size: clamp(1.2rem, 1.5vw, 1.45rem);
    font-weight: 450;
    letter-spacing: -0.02em;
    line-height: 1.4;
  }

  .about-intro p.about-perspective {
    font-family: var(--font-sans);
    font-size: 1.125rem;
    font-weight: 400;
    letter-spacing: 0;
    line-height: var(--leading-body);
    color: var(--fg-muted);
  }

  .about-section,
  .about-close {
    scroll-margin-top: calc(var(--header-h) + 0.75rem);
  }

  .about-section {
    padding-top: clamp(3.5rem, 7vw, 6rem);
  }

  .about-section h2,
  .about-close h2 {
    display: flex;
    align-items: baseline;
    gap: 0.75rem;
    font-family: var(--font-serif);
    font-optical-sizing: auto;
    font-size: clamp(1.85rem, 2.4vw, 2.45rem);
    font-weight: 480;
    letter-spacing: -0.03em;
    line-height: 1.1;
  }

  .section-icon {
    display: inline-grid;
    place-items: center;
    width: 1.15rem;
    height: 1.15rem;
    color: var(--mark);
    font-family: var(--font-sans);
    font-size: 0.85rem;
    font-weight: 600;
    line-height: 1;
    transform: translateY(-0.1em);
  }

  .role-list,
  .study-list,
  .practice-list,
  .award-list,
  .about-contact-links,
  .role-points {
    list-style: none;
    margin: 0;
    padding: 0;
  }

  .role-list {
    margin-top: var(--space-5);
  }

  .role {
    display: grid;
    gap: 0.65rem;
    margin-top: 0.85rem;
    padding: 1.35rem;
    border: 1px solid var(--line);
    border-radius: 0.15rem 1.1rem 0.15rem 1.1rem;
    background: color-mix(in srgb, var(--bg-elevated) 72%, transparent);
    transition: border-color 260ms var(--ease), transform 260ms var(--ease), background-color 260ms var(--ease);
  }

  .role:first-child {
    border-color: color-mix(in srgb, var(--mark) 48%, var(--line));
  }

  .role:hover {
    border-color: var(--fg-muted);
    background: var(--bg-elevated);
    transform: translateY(-0.15rem);
  }

  .role-dates,
  .study-grid h3,
  .practice-grid h3,
  .role-note span {
    font-size: var(--text-xs);
    font-weight: 600;
    letter-spacing: var(--tracking-label);
    text-transform: uppercase;
  }

  .role-company {
    margin-top: 0.4rem;
    font-size: 1rem;
    line-height: 1.35;
    color: var(--fg-muted);
  }

  .role-dates {
    color: var(--fg);
  }

  .study-meta,
  .award-detail,
  .role-note {
    color: var(--fg-muted);
  }

  .role-body h3,
  .study-name,
  .award-list h3 {
    font-family: var(--font-serif);
    font-weight: 500;
    letter-spacing: -0.02em;
  }

  .role-body h3 {
    font-size: 1.45rem;
    line-height: 1.2;
    margin-bottom: 0.55rem;
  }

  .role-points {
    display: grid;
    gap: 0.55rem;
    margin-top: 0.95rem;
  }

  .role-points li {
    position: relative;
    padding-left: 0.95rem;
  }

  .role-points li::before {
    content: "";
    position: absolute;
    left: 0;
    top: 0.7em;
    width: 0.4rem;
    height: 1px;
    background: var(--fg-muted);
  }

  .role-note {
    margin-top: 1rem;
    padding-top: 0.85rem;
    border-top: 1px solid var(--line);
    font-size: 1rem;
    line-height: 1.55;
  }

  .role-note span {
    display: block;
    margin-bottom: 0.35rem;
    color: var(--fg);
  }

  .study-grid,
  .practice-grid {
    display: grid;
    gap: var(--space-6);
    margin-top: var(--space-5);
    padding-top: var(--space-5);
  }

  .study-grid > div,
  .practice-grid > div {
    padding-inline: 0.1rem;
  }

  .study-list,
  .practice-list {
    display: grid;
    gap: 1rem;
    margin-top: 0.9rem;
  }

  .practice-list {
    gap: 0.35rem;
  }

  .practice-list li {
    padding-block: 0.25rem;
    border-bottom: 1px solid color-mix(in srgb, var(--line) 70%, transparent);
    font-size: 1rem;
  }

  .practice-list li:last-child {
    border-bottom: 0;
  }

  .study-name {
    font-size: 1.28rem;
    line-height: 1.25;
  }

  .study-meta {
    margin-top: 0.25rem;
    font-size: 1rem;
  }

  .award-list {
    display: grid;
    gap: var(--space-5);
    margin-top: var(--space-5);
    padding-top: var(--space-5);
  }

  .award-list li {
    padding: 1.15rem;
    border-top: 1px solid var(--line);
  }

  .award-when {
    font-family: var(--font-serif);
    font-size: clamp(1.6rem, 2vw, 2rem);
    font-weight: 450;
    letter-spacing: -0.03em;
    line-height: 1;
  }

  .award-list h3 {
    margin-top: 0.55rem;
    font-size: 1.25rem;
    line-height: 1.25;
  }

  .award-detail {
    margin-top: 0.3rem;
    font-size: 1rem;
  }

  .about-close {
    max-width: 36rem;
    margin-top: var(--space-7);
    padding-top: var(--space-6);
    padding-bottom: var(--space-4);
    border-top: 2px solid var(--fg);
    border-bottom: 1px solid var(--line);
  }

  .about-close p {
    margin-top: 0.85rem;
    color: var(--fg-muted);
  }

  @media (min-width: 48rem) {
    .about-opening {
      display: grid;
      grid-template-columns: minmax(8rem, 0.28fr) minmax(0, 1fr);
      column-gap: var(--space-7);
      align-items: start;
    }

    .about-opening .eyebrow {
      padding-top: 0.55rem;
    }

    .about-opening .about-headline,
    .about-opening .about-intro {
      grid-column: 2;
    }

    .about-opening .about-intro {
      margin-top: var(--space-5);
    }

    .role {
      grid-template-columns: 11.5rem minmax(0, 42rem);
      column-gap: var(--space-6);
      align-items: start;
    }

    .study-grid,
    .practice-grid {
      grid-template-columns: 1fr 1fr;
      column-gap: var(--space-7);
    }
  }

  @media (min-width: 64rem) {
    .award-list {
      grid-template-columns: repeat(3, minmax(0, 1fr));
      column-gap: var(--space-6);
    }
  }
  /* Editorial CV-inspired layer */
  .about-page { padding-bottom: clamp(4rem, 9vw, 9rem); }
  .about-opening { isolation: isolate; padding-block: clamp(4.5rem, 10vw, 9rem) clamp(4rem, 8vw, 7rem); }
  .about-opening::before { content: ""; position: absolute; inset: 1.5rem 0; z-index: -1; border: 1px solid color-mix(in srgb, var(--line) 72%, transparent); background-image: linear-gradient(color-mix(in srgb, var(--line) 22%, transparent) 1px, transparent 1px), linear-gradient(90deg, color-mix(in srgb, var(--line) 22%, transparent) 1px, transparent 1px); background-size: 2rem 2rem; opacity: .42; pointer-events: none; }
  .about-opening .eyebrow { width: fit-content; padding: .55rem .8rem; border: 1px solid var(--fg-muted); background: var(--bg); font-size: .72rem; letter-spacing: .2em; }
  .about-headline { max-width: 10.5em; margin-top: 1.35rem; font-family: var(--font-serif); font-size: var(--text-display); font-weight: 450; letter-spacing: -.04em; line-height: .98; text-transform: none; }
  .about-intro { max-width: 55rem; margin-top: clamp(2.5rem, 5vw, 5rem); gap: 1.5rem; }
  .about-intro p { max-width: 27rem; font-size: clamp(1.45rem, 2.1vw, 2rem); line-height: 1.2; }
  .about-intro p.about-perspective { max-width: 34rem; margin-left: clamp(0rem, 10vw, 9rem); font-size: clamp(1.05rem, 1.45vw, 1.35rem); line-height: 1.55; }
  .about-section { padding-top: clamp(5rem, 11vw, 10rem); }
  .about-section h2, .about-close h2 { font-size: clamp(2.3rem, 4vw, 4.3rem); }
  .role-list { margin-top: clamp(2rem, 4vw, 4rem); padding-left: clamp(1rem, 4vw, 3.5rem); border-left: 1px solid var(--line); }
  .role { position: relative; gap: 1.25rem; margin-top: 0; padding: 0 0 clamp(3rem, 6vw, 6rem); border: 0; border-radius: 0; background: transparent; }
  .role + .role { padding-top: clamp(3rem, 6vw, 6rem); border-top: 1px solid color-mix(in srgb, var(--line) 72%, transparent); }
  .role:hover { border-color: transparent; background: transparent; transform: none; }
  .role::before { content: ""; position: absolute; left: calc(clamp(1rem, 4vw, 3.5rem) * -1 - .25rem); top: .55rem; width: .5rem; height: .5rem; border-radius: 50%; background: var(--mark); }
  .role-dates { font-size: .72rem; letter-spacing: .2em; }
  .role-company { margin-top: .65rem; font-size: .82rem; font-weight: 600; letter-spacing: .14em; text-transform: uppercase; }
  .role-body h3 { font-family: var(--font-sans); font-size: clamp(1.75rem, 3vw, 3rem); font-weight: 700; letter-spacing: -.055em; line-height: .98; text-transform: uppercase; }
  .role-points { gap: 1rem; margin-top: 1.6rem; }
  .role-points li { max-width: 52rem; padding-left: 1.8rem; font-size: clamp(1.1rem, 1.4vw, 1.35rem); line-height: 1.5; color: var(--fg-muted); }
  .role-points li::before { left: .1rem; top: .8em; width: .75rem; height: 2px; background: var(--mark); }
  @media (min-width: 48rem) { .role { grid-template-columns: 11.5rem minmax(0, 1fr); column-gap: clamp(2rem, 6vw, 7rem); } }

  @media (min-width: 48rem) {
    .about-intro {
      max-width: none;
      grid-template-columns: minmax(0, 1.15fr) minmax(15rem, .85fr);
      column-gap: clamp(2.5rem, 8vw, 8rem);
      align-items: start;
    }

    .about-intro p:not(.about-perspective) { grid-column: 1; }
    .about-intro p.about-perspective {
      grid-column: 2;
      grid-row: 1 / span 2;
      margin: .35rem 0 0;
      padding-top: 1.25rem;
      border-top: 2px solid var(--fg);
    }
  }

  @media (max-width: 47.99rem) {
    .about-intro p.about-perspective { margin-left: 0; }
  }
</style>
