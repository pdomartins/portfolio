    "Munich, Germany": "Munique, Alemanha",
    "São Paulo, Brazil": "São Paulo, Brasil",
    "Have a complex problem to solve?": "Você tem um problema complexo para resolver?",
    "I’m always interested in thoughtful conversations about digital products, design strategy, and emerging technology.": "Tenho interesse em conversas sobre produtos digitais, estratégia de design e tecnologias emergentes.",
    "I design digital products that move businesses forward — through strategy, UX/UI, and AI.": "Crio produtos digitais que impulsionam negócios — unindo estratégia, UX/UI e IA.",
    "I’m Pedro Martins, a Senior Product Designer with 9+ years of experience across digital products, enterprise SaaS, fintech, e-commerce, and strategic innovation.": "Sou Pedro Martins, Senior Product Designer com mais de 9 anos de experiência em produtos digitais, SaaS corporativo, fintech, e-commerce e inovação estratégica.",
    "I combine product strategy, UX/UI design, and AI to turn complex challenges into clear, useful digital experiences — from discovery and interaction design to prototyping and delivery.": "Combino estratégia de produto, design UX/UI e IA para transformar desafios complexos em experiências digitais claras e úteis — da descoberta e do design de interação à prototipação e entrega.",
    "My background combines digital product design, industrial design, strategic innovation, and emerging technologies. This perspective helps me connect user needs, business goals, and AI-enabled possibilities across products, services, and systems.": "Minha experiência combina design de produtos digitais, design industrial, inovação estratégica e tecnologias emergentes. Essa perspectiva me ajuda a conectar necessidades das pessoas, objetivos de negócio e possibilidades habilitadas por IA em produtos, serviços e sistemas.",
    "I connect strategy, design, and technology to create digital products that make complex things feel simple.": "Conecto estratégia, design e tecnologia para criar produtos digitais que tornam o complexo mais simples.",
    "Skip to content": "Ir para o conteúdo",
    "Page not found": "Página não encontrada",
    "Back to the work": "Voltar aos trabalhos",
  };

  // Copy blocks are rendered as separate paragraphs. Expand translated blocks
  // into paragraph-level entries so long case-study sections translate too.
  const translationLookup: Record<string, string> = { ...translations };
  Object.entries(translations).forEach(([source, translated]) => {
    const sourceParts = source.split(/\n\n+/).map((part) => part.trim()).filter(Boolean);
    const translatedParts = translated.split(/\n\n+/).map((part) => part.trim()).filter(Boolean);
    if (sourceParts.length < 2 || sourceParts.length !== translatedParts.length) return;
    sourceParts.forEach((part, index) => {
      if (!translationLookup[part]) translationLookup[part] = translatedParts[index];
    });
  });

  const originalText = new WeakMap<Text, string>();

  function setLanguage(language: "en" | "pt") {
    document.documentElement.lang = language === "pt" ? "pt-BR" : "en";
    document.documentElement.dataset.language = language;
    document.querySelectorAll<HTMLElement>("[data-language-flag]").forEach((item) => {
      item.classList.toggle("is-active", item.dataset.languageFlag === language);
    });
    const walker = document.createTreeWalker(document.body, NodeFilter.SHOW_TEXT);
    const nodes: Text[] = [];
    while (walker.nextNode()) nodes.push(walker.currentNode as Text);
    nodes.forEach((node) => {
      if (!originalText.has(node)) originalText.set(node, node.textContent || "");
      const source = originalText.get(node) || "";
      const original = source.trim();
      if (!original) return;
      const translated = translationLookup[original];
      if (translated) node.textContent = language === "pt" ? source.replace(original, translated) : source;
    });
    try { localStorage.setItem("language", language); } catch (error) {}
  }

  document.addEventListener("click", (event) => {
    const target = event.target;
    if (!(target instanceof Element) || !target.closest("[data-language-toggle]")) return;
    setLanguage(document.documentElement.dataset.language === "pt" ? "en" : "pt");
  });

  function restoreLanguage() {
    try {
      const stored = localStorage.getItem("language");
      setLanguage(stored === "pt" ? "pt" : "en");
    } catch (error) {
      setLanguage("en");
    }
  }

  restoreLanguage();
  document.addEventListener("astro:page-load", restoreLanguage);
</script>

<style>
  .language-toggle {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    gap: 0.42rem;
    min-width: 4.55rem;
    min-height: 2.2rem;
    padding: 0.35rem 0.55rem;
    border: 1px solid var(--line);
    background: transparent;
    color: var(--fg-muted);
    font: inherit;
    font-size: 1.05rem;
    line-height: 1;
    cursor: pointer;
    transition: border-color var(--duration) var(--ease), color var(--duration) var(--ease), background-color var(--duration) var(--ease);
  }

  .language-toggle:hover,
  .language-toggle:focus-visible {
    background: color-mix(in srgb, var(--fg) 5%, var(--bg));
    color: var(--fg);
  }

  .language-flag {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    opacity: 0.42;
    filter: grayscale(0.35);
    transform: scale(0.92);
    transition: opacity var(--duration) var(--ease), filter var(--duration) var(--ease), transform var(--duration) var(--ease);
  }

  .language-flag.is-active {
    opacity: 1;
    filter: none;
    transform: scale(1.08);
  }

  .language-divider {
    color: var(--line);
    font-size: 0.9rem;
  }
</style>
