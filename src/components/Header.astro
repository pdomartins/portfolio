---
import ThemeToggle from "./ThemeToggle.astro";

const pathname = Astro.url.pathname.replace(/\/$/, "") || "/";
const workCurrent = pathname === "/" || pathname.startsWith("/work");
const aboutCurrent = pathname === "/about";
---

<noscript>
  <style>
    @media (max-width: 40rem) {
      .menu-button {
        display: none !important;
      }

      .site-nav {
        display: flex !important;
        flex-basis: 100%;
        flex-direction: column;
        align-items: flex-start;
        margin-left: 0;
        padding-top: 0.85rem;
        border-top: 1px solid var(--line);
      }

      .site-nav a {
        font-family: var(--font-sans);
        font-size: 1.05rem;
        font-weight: 650;
        letter-spacing: 0.12em;
        color: var(--fg);
        text-decoration: none;
        text-transform: uppercase;
      }
    }
  </style>
</noscript>

<header class="site-header">
  <div class="container bar">
    <a class="wordmark" href="/"><span>Pedro</span><span>Martins</span></a>
    <nav id="site-nav" class="site-nav" aria-label="Primary">
      <a href="/#work" aria-current={workCurrent ? "page" : undefined}>Work</a>
      <a href="/about" aria-current={aboutCurrent ? "page" : undefined}>About</a>
    </nav>
    <div class="bar-tools">
      <button class="language-toggle" type="button" data-language-toggle aria-label="Change language">
        <span class="language-flag" data-language-flag="pt" aria-label="Português">🇧🇷</span>
        <span class="language-divider" aria-hidden="true">/</span>
        <span class="language-flag is-active" data-language-flag="en" aria-label="English">🇺🇸</span>
      </button>
      <ThemeToggle />
      <button
        class="menu-button"
        type="button"
        data-menu-button
        aria-expanded="false"
        aria-controls="site-nav"
      >
        <span data-menu-label>Menu</span>
      </button>
    </div>
  </div>
</header>

<script>
  function menuButton() {
    return document.querySelector<HTMLButtonElement>("[data-menu-button]");
  }

  function menuPanel() {
    return document.getElementById("site-nav");
  }

  function setMenu(open: boolean) {
    const button = menuButton();
    const panel = menuPanel();
    if (!button || !panel) return;
    panel.classList.toggle("is-open", open);
    button.setAttribute("aria-expanded", String(open));
    const label = button.querySelector("[data-menu-label]");
    if (label) label.textContent = open ? "Close" : "Menu";
  }

  document.addEventListener("click", (event) => {
    const target = event.target;
    if (!(target instanceof Element)) return;

    if (target.closest("[data-menu-button]")) {
      setMenu(!menuPanel()?.classList.contains("is-open"));
      return;
    }

    if (target.closest("#site-nav a")) setMenu(false);
  });

  document.addEventListener("keydown", (event) => {
    if (event.key !== "Escape" || !menuPanel()?.classList.contains("is-open")) return;
    setMenu(false);
    menuButton()?.focus();
  });

  window.matchMedia("(min-width: 40.01rem)").addEventListener("change", (event) => {
    if (event.matches) setMenu(false);
  });

  const translations: Record<string, string> = {
    "Work": "Trabalho",
    "About": "Sobre",
    "Menu": "Menu",
    "Close": "Fechar",
    "Selected work": "Trabalhos selecionados",
    "Let’s work on something complex.": "Vamos trabalhar em algo complexo.",
    "For collaborations and new work, reach out through the links below.": "Para colaborações e novos projetos, entre em contato pelos links abaixo.",
    "Open to select collaborations": "Disponível para colaborações selecionadas",
    "About": "Sobre",
    "Experience": "Experiência",
    "Education & Learning": "Formação e aprendizado",
    "Degrees": "Graduação e pós-graduação",
    "Courses": "Cursos",
    "Areas of Practice": "Áreas de atuação",
    "Recognition": "Reconhecimentos",
    "Have a complex problem to solve?": "Você tem um problema complexo para resolver?",
    "I’m always interested in thoughtful conversations about digital products, design strategy, and emerging technology.": "Tenho interesse em conversas sobre produtos digitais, estratégia de design e tecnologias emergentes.",
    "Case study in preparation. This page is ready for the narrative, the decisions, and the visuals.": "Estudo de caso em preparação. Esta página está pronta para receber a narrativa, as decisões e os visuais.",
    "This section will describe the context and the challenge.": "Esta seção apresentará o contexto e o desafio.",
    "This section will describe the approach and the process.": "Esta seção apresentará a abordagem e o processo.",
    "This section will describe the key design decisions.": "Esta seção apresentará as principais decisões de design.",
    "Project visuals will be placed here.": "Os visuais do projeto serão inseridos aqui.",
    "This section will describe outcomes and learnings.": "Esta seção apresentará os resultados e aprendizados.",
    "AI-powered commerce platform": "Plataforma de comércio com inteligência artificial",
    "Fintech product experiences": "Experiências digitais para fintech",
    "Banking app redesign": "Redesign de aplicativo bancário",
    "Employee onboarding experience": "Experiência de integração de colaboradores",
    "Design system": "Sistema de design",
    "Sustainability strategy": "Estratégia de sustentabilidade",
    "Experimental mobility concept": "Conceito experimental de mobilidade",
    "Senior Product Designer": "Senior Product Designer",
    "Turning complexity into meaningful digital experiences.": "Transformando complexidade em experiências digitais significativas.",
    "I design digital products that move businesses forward.": "Crio produtos digitais que impulsionam negócios.",
    "Strategy, UX/UI, and AI for complex products, services, and systems.": "Estratégia, UX/UI e IA para produtos, serviços e sistemas complexos.",
    "Strategy": "Estratégia",
    "UX / UI design": "Design UX / UI",
    "AI Tools": "Ferramentas de IA",
    "Iungo AI Suite": "Iungo AI Suite",
    "AI-powered product intelligence for commerce": "Inteligência de produto com IA para comércio",
    "Context and challenge": "Contexto e desafio",
    "Approach and process": "Abordagem e processo",
    "Key design decisions": "Principais decisões de design",
    "Final experience and visuals": "Experiência final e visuais",
    "Outcomes and learnings": "Resultados e aprendizados",
    "Iungo AI Suite is a connected portfolio of AI products for commerce: it organizes product information, decides what to show and when, guides shoppers to the right choice, and helps complete the journey across channels. I shaped the product narrative and experience model around one idea: intelligence should move through the whole customer journey, not live inside isolated features.": "O Iungo AI Suite é um portfólio conectado de produtos de IA para comércio: organiza informações de produtos, decide o que mostrar e quando, orienta as pessoas até a escolha certa e ajuda a concluir a jornada em diferentes canais. Estruturei a narrativa do produto e o modelo de experiência em torno de uma ideia: a inteligência deve percorrer toda a jornada, e não viver em funcionalidades isoladas.",
    "Iungo was moving from a collection of capabilities toward a sellable AI product portfolio. The challenge was not only naming products. It was making the architecture legible: six solutions, three shared engines, different buyers, different moments in the journey, and a clear distinction between what is sold and what powers everything underneath.": "A Iungo estava passando de uma coleção de capacidades para um portfólio de produtos de IA comercializável. O desafio não era apenas nomear produtos. Era tornar a arquitetura compreensível: seis soluções, três engines compartilhados, diferentes compradores, diferentes momentos da jornada e uma distinção clara entre o que é vendido e o que sustenta tudo por baixo.",
    "The process below is a portfolio reconstruction based on the product-release material and architecture decisions documented by the team.": "O processo abaixo é uma reconstrução de portfólio baseada no material de releases e nas decisões de arquitetura documentadas pela equipe.",
    "The most important decision was to separate the customer-facing solutions from the infrastructure that makes them intelligent. The Behavior Engine became an internal component that reads behavior, intent, propensity, and channel affinity. The Semantic Engine understands catalog structure, attributes, relationships, and knowledge. The Generative Engine creates content, conversation, and action.": "A decisão mais importante foi separar as soluções voltadas ao cliente da infraestrutura que as torna inteligentes. O Behavior Engine tornou-se um componente interno que interpreta comportamento, intenção, propensão e afinidade de canal. O Semantic Engine entende a estrutura do catálogo, atributos, relações e conhecimento. O Generative Engine cria conteúdo, conversa e ação.",
    "The work gave the portfolio a coherent story for product, engineering, and commercial conversations. It clarified the role of each solution, made the shared engines visible without selling them separately, and created a practical sequence for the next releases.": "O trabalho deu ao portfólio uma narrativa coerente para conversas de produto, engenharia e negócio. Esclareceu o papel de cada solução, tornou os engines compartilhados visíveis sem vendê-los separadamente e criou uma sequência prática para os próximos releases.",
    "I design digital products that move businesses forward — through strategy, UX/UI, and AI.": "Crio produtos digitais que impulsionam negócios — unindo estratégia, UX/UI e IA.",
    "I’m Pedro Martins, a Senior Product Designer with 9+ years of experience across digital products, enterprise SaaS, fintech, e-commerce, and strategic innovation.": "Sou Pedro Martins, Senior Product Designer com mais de 9 anos de experiência em produtos digitais, SaaS corporativo, fintech, e-commerce e inovação estratégica.",
    "I combine product strategy, UX/UI design, and AI to turn complex challenges into clear, useful digital experiences — from discovery and interaction design to prototyping and delivery.": "Combino estratégia de produto, design UX/UI e IA para transformar desafios complexos em experiências digitais claras e úteis — da descoberta e do design de interação à prototipação e entrega.",
    "My background combines digital product design, industrial design, strategic innovation, and emerging technologies. This perspective helps me connect user needs, business goals, and AI-enabled possibilities across products, services, and systems.": "Minha experiência combina design de produtos digitais, design industrial, inovação estratégica e tecnologias emergentes. Essa perspectiva me ajuda a conectar necessidades das pessoas, objetivos de negócio e possibilidades habilitadas por IA em produtos, serviços e sistemas.",
    "I connect strategy, design, and technology to create digital products that make complex things feel simple.": "Conecto estratégia, design e tecnologia para criar produtos digitais que tornam o complexo mais simples.",
    "Skip to content": "Ir para o conteúdo",
    "Page not found": "Página não encontrada",
    "Back to the work": "Voltar aos trabalhos",
  };

  const originalText = new WeakMap<Text, string>();

  function setLanguage(language: "en" | "pt") {
    document.documentElement.lang = language === "pt" ? "pt-BR" : "en";
    document.documentElement.dataset.language = language;
    document.querySelectorAll<HTMLElement>("[data-language-flag]").forEach((item) => {
      item.classList.toggle("is-active", item.dataset.languageFlag === language);
    });
    const walker = document.createTreeWalker(document.body, NodeFilter.SHOW_TEXT);
    const nodes: Text[] = [];
    while (walker.nextNode()) nodes.push(walker.currentNode as Text);
    nodes.forEach((node) => {
      if (!originalText.has(node)) originalText.set(node, node.textContent || "");
      const source = originalText.get(node) || "";
      const original = source.trim();
      if (!original) return;
      const translated = translations[original];
      if (translated) node.textContent = language === "pt" ? source.replace(original, translated) : source;
    });
    try { localStorage.setItem("language", language); } catch (error) {}
  }

  document.addEventListener("click", (event) => {
    const target = event.target;
    if (!(target instanceof Element) || !target.closest("[data-language-toggle]")) return;
    setLanguage(document.documentElement.dataset.language === "pt" ? "en" : "pt");
  });

  try {
    if (localStorage.getItem("language") === "pt") setLanguage("pt");
  } catch (error) {}
</script>

<style>
  .language-toggle {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    gap: 0.42rem;
    min-width: 4.55rem;
    min-height: 2.2rem;
    padding: 0.35rem 0.55rem;
    border: 1px solid var(--line);
    background: transparent;
    color: var(--fg-muted);
    font: inherit;
    font-size: 1.05rem;
    line-height: 1;
    cursor: pointer;
    transition: border-color var(--duration) var(--ease), color var(--duration) var(--ease), background-color var(--duration) var(--ease);
  }

  .language-toggle:hover,
  .language-toggle:focus-visible {
    background: color-mix(in srgb, var(--fg) 5%, var(--bg));
    color: var(--fg);
  }

  .language-flag {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    opacity: 0.42;
    filter: grayscale(0.35);
    transform: scale(0.92);
    transition: opacity var(--duration) var(--ease), filter var(--duration) var(--ease), transform var(--duration) var(--ease);
  }

  .language-flag.is-active {
    opacity: 1;
    filter: none;
    transform: scale(1.08);
  }

  .language-divider {
    color: var(--line);
    font-size: 0.9rem;
  }
</style>
