---
interface Props {
  id?: string;
  title: string;
  eyebrow?: string;
  variant?: "default" | "closing";
}

const { id, title, eyebrow, variant = "default" } = Astro.props;
const headingId = `${id ?? "section"}-title`;
---

<section
  class:list={["section", variant === "closing" && "is-closing"]}
  id={id}
  aria-labelledby={headingId}
>
  <div class="section-heading">
    <h2 id={headingId}>{title}</h2>
    {eyebrow && <p class="eyebrow">{eyebrow}</p>}
  </div>
  <div class="section-body">
    <slot />
  </div>
</section>
