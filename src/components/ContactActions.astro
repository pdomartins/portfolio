---
interface Props {
  email: string;
  linkedin: string;
}

const { email, linkedin } = Astro.props;
const whatsapp = "https://wa.me/5511994424041?text=Ol%C3%A1%2C%20Pedro!";
---

<div class="contact-actions" aria-label="Contact options">
  <a class="contact-action is-primary" href={`mailto:${email}`}>
    <span class="contact-action-icon" aria-hidden="true">
      <svg viewBox="0 0 24 24"><path d="M3.5 6.5h17v11h-17z"></path><path d="m4 7 8 6 8-6"></path></svg>
    </span>
    <span class="contact-action-copy"><strong>Send me an email</strong><small>{email}</small></span>
    <span class="contact-action-arrow" aria-hidden="true">↗</span>
  </a>
  <a class="contact-action" href={whatsapp} target="_blank" rel="noreferrer">
    <span class="contact-action-icon" aria-hidden="true">
      <svg viewBox="0 0 24 24"><path d="M20 11.5a8 8 0 0 1-11.8 7L4 19.5l1.1-4A8 8 0 1 1 20 11.5Z"></path><path d="M9 8.5c.2 1.6 1.2 3 2.7 3.8 1 .5 1.7.7 2.2.2l.7-.7"></path></svg>
    </span>
    <span class="contact-action-copy"><strong>Message me on WhatsApp</strong><small>Direct message</small></span>
    <span class="contact-action-arrow" aria-hidden="true">↗</span>
  </a>
  <a class="contact-action" href={linkedin} target="_blank" rel="noreferrer">
    <span class="contact-action-icon" aria-hidden="true">
      <svg viewBox="0 0 24 24"><path d="M6 8.5V18"></path><path d="M6 5.5v.1"></path><path d="M10.5 18v-5.2a2.8 2.8 0 0 1 5.6 0V18"></path><path d="M10.5 12.5V18"></path></svg>
    </span>
    <span class="contact-action-copy"><strong>Find me on LinkedIn</strong><small>Network &amp; collaborate</small></span>
    <span class="contact-action-arrow" aria-hidden="true">↗</span>
  </a>
</div>

<style>
  .contact-actions {
    display: grid;
    gap: 0.7rem;
    margin-top: var(--space-6);
    width: min(var(--content), calc(100vw - (var(--gutter) * 2)));
  }

  .contact-action {
    position: relative;
    display: grid;
    grid-template-columns: 2.2rem minmax(0, 1fr) auto;
    align-items: center;
    gap: 0.85rem;
    min-height: 5.4rem;
    padding: 0.85rem 1rem;
    border: 1px solid var(--line);
    border-radius: 0.15rem 1.25rem 0.15rem 1.25rem;
    background: color-mix(in srgb, var(--bg-elevated) 65%, transparent);
    text-decoration: none;
    transition: transform 260ms var(--ease), border-color 260ms var(--ease), background-color 260ms var(--ease);
  }

  .contact-action:hover,
  .contact-action:focus-visible {
    border-color: var(--fg);
    background: var(--bg-elevated);
    transform: translateY(-0.3rem);
  }

  .contact-action.is-primary {
    border-color: var(--fg);
    background: var(--fg);
    color: var(--bg);
  }

  .contact-action.is-primary:hover,
  .contact-action.is-primary:focus-visible {
    border-color: var(--mark);
    background: var(--mark);
    color: var(--bg);
  }

  .contact-action-icon {
    display: grid;
    place-items: center;
    width: 2rem;
    height: 2rem;
    border: 1px solid currentColor;
    border-radius: 50%;
  }

  .contact-action-icon svg {
    width: 1rem;
    height: 1rem;
    fill: none;
    stroke: currentColor;
    stroke-linecap: round;
    stroke-linejoin: round;
    stroke-width: 1.5;
  }

  .contact-action-copy {
    display: grid;
    gap: 0.12rem;
    min-width: 0;
  }

  .contact-action-copy strong {
    font-family: var(--font-sans);
    font-size: clamp(1.05rem, 1.45vw, 1.3rem);
    font-weight: 600;
    letter-spacing: -0.025em;
  }

  .contact-action-copy small {
    overflow-wrap: anywhere;
    color: var(--fg-muted);
    font-size: 0.82rem;
  }

  .is-primary .contact-action-copy small {
    color: color-mix(in srgb, var(--bg) 72%, transparent);
  }

  .contact-action:first-child .contact-action-copy small {
    font-size: 0.72rem;
    letter-spacing: -0.02em;
  }

  .contact-action-arrow {
    align-self: start;
    font-size: 1.25rem;
    line-height: 1;
    transition: transform 260ms var(--ease);
  }

  .contact-action:hover .contact-action-arrow,
  .contact-action:focus-visible .contact-action-arrow {
    transform: translate(0.18rem, -0.18rem);
  }

  @media (min-width: 48rem) {
    .contact-actions {
      grid-template-columns: repeat(3, minmax(0, 1fr));
    }
  }

  @media (max-width: 47.99rem) {
    .contact-actions {
      width: 100%;
      grid-template-columns: 1fr;
    }
  }
</style>
